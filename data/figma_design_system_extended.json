    "component_interaction_matrix": {
      "description": "Detailliertes Mapping: Komponente → User-Aktion → Prompt-Strategie → Output",
      "matrix": [
        {
          "component": "Button (Primary)",
          "size": "md",
          "color": "#2563EB",
          "user_action": "click",
          "interaction_state": "default → hover → active",
          "triggered_flow": "execute_primary_action",
          "prompt_trigger": {
            "strategy": "chain_of_thought",
            "context": "user_initiated_complex_task",
            "instruction": "User clicked primary CTA. Provide clear, structured steps."
          },
          "visual_feedback": "shadow_elevation + color_darken",
          "accessibility": {
            "aria_label": "required",
            "keyboard_navigation": "tab_focus_ring",
            "screen_reader": "button_label_and_status"
          }
        },
        {
          "component": "Input Field (Text)",
          "user_action": "focus",
          "interaction_state": "default → focus → blur",
          "triggered_flow": "user_data_entry",
          "prompt_trigger": {
            "strategy": "few_shot_learning",
            "context": "user_entering_data",
            "instruction": "User focused on input. Show contextual help and examples."
          },
          "visual_feedback": "blue_outline + helper_text_appear",
          "helper_content": {
            "placeholder": "e.g., chain-of-thought-analysis",
            "hint": "Use lowercase and hyphens",
            "examples": ["cot-analysis-v1", "few-shot-examples-v2"]
          }
        },
        {
          "component": "Card (Hoverable)",
          "user_action": "hover",
          "interaction_state": "default → hover",
          "triggered_flow": "explore_option",
          "prompt_trigger": {
            "strategy": "few_shot_learning",
            "context": "user_exploring_alternatives",
            "instruction": "User is exploring options. Show examples of similar items."
          },
          "visual_feedback": "shadow_elevation + slight_lift",
          "tooltip": {
            "show_delay": "800ms",
            "content": "{{card_title}}: {{card_description}}"
          }
        },
        {
          "component": "Modal Dialog",
          "user_action": "open",
          "interaction_state": "closed → opening_animation → open",
          "triggered_flow": "focused_decision",
          "prompt_trigger": {
            "strategy": "tree_of_thought",
            "context": "user_making_decision",
            "instruction": "User is making a decision. Present multiple perspectives clearly."
          },
          "visual_feedback": "overlay_fade_in + modal_slide_up",
          "keyboard_support": {
            "escape_closes": true,
            "tab_traps_focus": true
          }
        },
        {
          "component": "Dropdown / Select",
          "user_action": "click_to_open",
          "interaction_state": "closed → open → selected",
          "triggered_flow": "select_option",
          "prompt_trigger": {
            "strategy": "few_shot_learning",
            "context": "user_selecting_from_options",
            "instruction": "User is selecting from predefined options. Show clear option differences."
          },
          "visual_feedback": "chevron_rotation + menu_slide_down"
        },
        {
          "component": "Tab Navigation",
          "user_action": "click_tab",
          "interaction_state": "inactive_tab → active_tab",
          "triggered_flow": "switch_context",
          "prompt_trigger": {
            "strategy": "role_play_persona",
            "context": "context_switching",
            "instruction": "User switched to a new section. Adapt your expertise to this domain."
          },
          "visual_feedback": "underline_animation + content_fade_transition"
        },
        {
          "component": "Loading State (Spinner)",
          "user_action": "wait",
          "interaction_state": "processing",
          "triggered_flow": "background_validation",
          "prompt_trigger": {
            "strategy": "meta_reasoning",
            "context": "internal_processing",
            "instruction": "System is processing. Validate your intermediate results internally."
          },
          "visual_feedback": "animated_spinner + status_text",
          "messaging": "Processing your {{item_name}}...",
          "max_display_time": "30_seconds",
          "cancel_option": true
        },
        {
          "component": "Error Message (Input Validation)",
          "user_action": "submit_invalid_data",
          "interaction_state": "error",
          "triggered_flow": "error_recovery",
          "prompt_trigger": {
            "strategy": "role_play_persona",
            "role": "helpful_expert",
            "context": "user_needs_help",
            "instruction": "User made an error. Guide them as a patient expert with solutions."
          },
          "visual_feedback": "red_border + shake_animation + error_message_appear",
          "error_message": {
            "problem": "What went wrong (technical)",
            "reason": "Why it matters (user perspective)",
            "solution": "How to fix it (actionable steps)"
          }
        }
      ]
    },

    "evaluation_framework_extended": {
      "quality_dimensions": {
        "coherence": {
          "id": "dim_coherence",
          "name": "Coherence",
          "description": "Logische Konsistenz und Flow der Antwort",
          "scoring_rubric": {
            "5": "Perfect logical flow, every sentence builds on previous, no contradictions",
            "4": "Strong flow, minor logical jumps, mostly consistent",
            "3": "Adequate flow, some logical gaps or mild contradictions",
            "2": "Weak flow, significant logical jumps, some contradictions",
            "1": "Poor or incoherent, many contradictions or random statements"
          },
          "prompt_check": "Does this response follow a clear logical structure? Are ideas connected?",
          "weight": 0.15
        },
        "completeness": {
          "id": "dim_completeness",
          "name": "Completeness",
          "description": "Beantwortet alle Teile der Frage",
          "scoring_rubric": {
            "5": "Fully answers all aspects of question, covers edge cases, proactive additions",
            "4": "Addresses all main aspects, minor gaps in detail",
            "3": "Addresses most aspects, some gaps in depth or secondary points",
            "2": "Addresses some aspects, significant gaps or missing key points",
            "1": "Answers only surface level or misses major parts"
          },
          "evaluation_criteria": [
            "All questions addressed",
            "All context consumed",
            "Edge cases considered",
            "Follow-up needs anticipated"
          ],
          "weight": 0.25
        },
        "accuracy": {
          "id": "dim_accuracy",
          "name": "Accuracy",
          "description": "Factual Korrektheit und Aktualität",
          "scoring_rubric": {
            "5": "All facts accurate, current information, proper citations",
            "4": "Mostly accurate, minor outdated info, few citation gaps",
            "3": "Largely accurate, some old info, citation gaps",
            "2": "Several factual errors, significant outdated content",
            "1": "Major factual errors, mostly outdated or incorrect"
          },
          "fact_check_sources": [
            "official_documentation",
            "peer_reviewed_research",
            "industry_standards"
          ],
          "weight": 0.30
        },
        "clarity": {
          "id": "dim_clarity",
          "name": "Clarity",
          "description": "Verständlichkeit für die Zielgruppe",
          "scoring_rubric": {
            "5": "Crystal clear, perfect for audience, excellent examples",
            "4": "Clear, mostly understandable, adequate examples",
            "3": "Reasonably clear, some confusing parts, few examples",
            "2": "Unclear, complex for intended audience, lacks examples",
            "1": "Very unclear or incomprehensible for the audience"
          },
          "audience_levels": ["beginner", "intermediate", "expert"],
          "weight": 0.20
        },
        "relevance": {
          "id": "dim_relevance",
          "name": "Relevance",
          "description": "Bezug zur ursprünglichen Frage",
          "scoring_rubric": {
            "5": "Perfectly relevant, focused on question, no filler",
            "4": "Mostly relevant, minor tangents, mostly focused",
            "3": "Relevant with some tangential content",
            "2": "Partially relevant, significant tangents",
            "1": "Off-topic or largely irrelevant"
          },
          "weight": 0.10
        }
      },

      "prompt_strategy_evaluation": {
        "cot_eval": {
          "strategy": "chain_of_thought",
          "specific_checks": [
            {
              "check": "Step clarity",
              "description": "Each step is clearly defined and actionable",
              "scoring": "1-5"
            },
            {
              "check": "Logical progression",
              "description": "Steps follow a logical sequence",
              "scoring": "1-5"
            },
            {
              "check": "Reasoning transparency",
              "description": "Why each step is necessary is explained",
              "scoring": "1-5"
            },
            {
              "check": "Completeness of reasoning",
              "description": "All reasoning steps are shown, not skipped",
              "scoring": "1-5"
            }
          ]
        },
        "few_shot_eval": {
          "strategy": "few_shot_learning",
          "specific_checks": [
            {
              "check": "Example relevance",
              "description": "Examples closely match the target task",
              "scoring": "1-5"
            },
            {
              "check": "Pattern clarity",
              "description": "The pattern to learn is obvious from examples",
              "scoring": "1-5"
            },
            {
              "check": "Example variety",
              "description": "Examples show different valid variations",
              "scoring": "1-5"
            },
            {
              "check": "Task application",
              "description": "New task correctly applies learned pattern",
              "scoring": "1-5"
            }
          ]
        },
        "role_play_eval": {
          "strategy": "role_play_persona",
          "specific_checks": [
            {
              "check": "Role consistency",
              "description": "Response stays in character throughout",
              "scoring": "1-5"
            },
            {
              "check": "Expertise authenticity",
              "description": "Advice reflects claimed expertise level",
              "scoring": "1-5"
            },
            {
              "check": "Communication style",
              "description": "Matches role's typical communication",
              "scoring": "1-5"
            },
            {
              "check": "Domain accuracy",
              "description": "Domain-specific content is accurate",
              "scoring": "1-5"
            }
          ]
        }
      }
    },

    "figma_layer_contract": {
      "description": "Verbindliche Layer-Struktur für Figma Frames",
      "required_structure": {
        "frame_naming": "PROMPT/{{prompt_id}}/{{version}}",
        "example": "PROMPT/cot-analysis/v1"
      },
      "required_children_frames": [
        {
          "name": "METADATA",
          "type": "group",
          "required_fields": [
            {
              "field": "title",
              "type": "text",
              "max_chars": 100
            },
            {
              "field": "description",
              "type": "text",
              "max_chars": 500
            },
            {
              "field": "category",
              "type": "text",
              "allowed_values": ["analysis", "generation", "reasoning", "classification", "other"]
            },
            {
              "field": "strategy",
              "type": "text",
              "allowed_values": ["chain-of-thought", "few-shot", "role-play", "tree-of-thought", "meta-reasoning"]
            },
            {
              "field": "version",
              "type": "text",
              "pattern": "^v\\d+(\\.\\d+)*$",
              "example": "v1, v1.0, v1.2.3"
            }
          ]
        },
        {
          "name": "CONTENT",
          "type": "group",
          "required_children": [
            {
              "name": "system",
              "type": "text_frame",
              "content_type": "system_message",
              "validation": "not_empty"
            },
            {
              "name": "user_template",
              "type": "text_frame",
              "content_type": "user_template",
              "validation": "not_empty"
            },
            {
              "name": "guardrails",
              "type": "text_frame",
              "content_type": "constraints",
              "validation": "optional"
            },
            {
              "name": "output_format",
              "type": "text_frame",
              "content_type": "output_spec",
              "validation": "optional"
            }
          ]
        },
        {
          "name": "EXAMPLES",
          "type": "group",
          "required_children": "dynamic",
          "example_structure": {
            "example_1": {
              "type": "group",
              "children": [
                {"name": "input", "type": "text_frame"},
                {"name": "output", "type": "text_frame"},
                {"name": "explanation", "type": "text_frame", "optional": true}
              ]
            }
          }
        },
        {
          "name": "STRATEGY_CONFIG",
          "type": "group",
          "strategy_specific": {
            "chain_of_thought": {
              "fields": ["num_steps", "step_structure", "reasoning_style"]
            },
            "few_shot": {
              "fields": ["num_examples", "example_format", "pattern_description"]
            },
            "role_play": {
              "fields": ["role_name", "expertise_areas", "communication_style"]
            },
            "tree_of_thought": {
              "fields": ["num_branches", "branch_comparison_format"]
            }
          }
        }
      ]
    },

    "workflow_integration": {
      "github_actions_workflow": {
        "trigger": "on_pull_request_figma_changes",
        "steps": [
          "detect_figma_file_changes",
          "export_prompts_from_figma",
          "validate_schema",
          "run_tests",
          "generate_prompt_catalog",
          "create_comment_with_diff"
        ]
      },
      "mcp_server_integration": {
        "tools_exposed": [
          {
            "tool": "list_prompts",
            "description": "List all available prompts"
          },
          {
            "tool": "get_prompt",
            "parameters": ["prompt_id", "version"]
          },
          {
            "tool": "create_prompt",
            "parameters": ["prompt_spec_json"]
          },
          {
            "tool": "evaluate_prompt",
            "parameters": ["prompt_id", "test_cases", "models"]
          }
        ]
      }
    }
  }
}
